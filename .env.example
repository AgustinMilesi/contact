# ==============================================================================
# Neon PostgreSQL Connection Strings
# ==============================================================================
# DATABASE_URL: Pooled connection string (with '-pooler' in the host).
# Used by the Next.js runtime and serverless functions via PgBouncer.
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Direct unpooled connection string (without '-pooler').
# Used exclusively by Prisma CLI for schema migrations (prisma migrate deploy/dev).
DIRECT_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# Email Delivery Service (Resend)
# ==============================================================================
# Resend API Key (get your key at https://resend.com/api-keys)
RESEND_API_KEY="re_your_api_key_here"

# Destination email where inquiries and submissions will be delivered
CONTACT_EMAIL="your-inbox@example.com"